# Copy to .env.local for local development. Vite only exposes variables prefixed with VITE_
# to the browser; everything else stays server-side. In CI and hosting, set these per environment.

# Supabase project (Settings -> API). The anon key is public by design; row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry crash reporting (optional locally; only reports from production builds)
VITE_SENTRY_DSN=
# Build-time only, for uploading source maps (secret)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# development | staging | production. Tags Sentry events and sets the trace sample rate.
VITE_APP_VARIANT=

# Set to 1 to print analytics events to the console
VITE_ANALYTICS_DEBUG=
