{
  "name": "seam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "images": "python3 scripts/generate_placeholders.py",
    "avatars": "python3 scripts/crop_avatars.py",
    "seed": "python3 scripts/build_seed.py",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.24.0",
    "@supabase/supabase-js": "^2.117.0",
    "framer-motion": "^12.23.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
